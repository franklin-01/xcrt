    ]),
]

MASKS = [("none", "None"), ("aperture", "Aperture grille"), ("slot", "Slot mask"), ("shadow", "Shadow mask")]
PRESET_NAME = re.compile(r"^[A-Za-z0-9._-]{1,31}$")


class XcrtLink:
    """Talks to xcrt through X properties on its compositor-selection window."""

    XA_STRING = 31
    PROP_MODE_APPEND = 2

    def __init__(self):
        lib = ctypes.util.find_library("X11")
        if not lib:
            raise RuntimeError("libX11 not found")
        x = self.x = ctypes.CDLL(lib)
        c = ctypes
        x.XOpenDisplay.restype = c.c_void_p
        x.XOpenDisplay.argtypes = [c.c_char_p]
        x.XDefaultScreen.argtypes = [c.c_void_p]
        x.XInternAtom.restype = c.c_ulong
        x.XInternAtom.argtypes = [c.c_void_p, c.c_char_p, c.c_int]
        x.XGetSelectionOwner.restype = c.c_ulong
        x.XGetSelectionOwner.argtypes = [c.c_void_p, c.c_ulong]
        x.XFetchName.argtypes = [c.c_void_p, c.c_ulong, c.POINTER(c.c_char_p)]
        x.XGetWindowProperty.argtypes = [
            c.c_void_p, c.c_ulong, c.c_ulong, c.c_long, c.c_long, c.c_int, c.c_ulong,
            c.POINTER(c.c_ulong), c.POINTER(c.c_int), c.POINTER(c.c_ulong), c.POINTER(c.c_ulong),
            c.POINTER(c.POINTER(c.c_ubyte)),
        ]
        x.XChangeProperty.argtypes = [
            c.c_void_p, c.c_ulong, c.c_ulong, c.c_ulong, c.c_int, c.c_int, c.c_char_p, c.c_int,
        ]
        x.XFree.argtypes = [c.c_void_p]
        x.XFlush.argtypes = [c.c_void_p]
        x.XSync.argtypes = [c.c_void_p, c.c_int]
        x.XDisplayString.restype = c.c_char_p
        x.XDisplayString.argtypes = [c.c_void_p]

        # xcrt can exit at any moment; Xlib's default handler would kill us on BadWindow
        handler_t = c.CFUNCTYPE(c.c_int, c.c_void_p, c.c_void_p)
        self._on_error = handler_t(lambda d, e: 0)
        x.XSetErrorHandler.argtypes = [handler_t]
        x.XSetErrorHandler(self._on_error)

        self.dpy = x.XOpenDisplay(None)
        if not self.dpy:
            raise RuntimeError("cannot open display %r" % os.environ.get("DISPLAY", ""))
        self.display_name = x.XDisplayString(self.dpy).decode()
        screen = x.XDefaultScreen(self.dpy)
        self.sel = x.XInternAtom(self.dpy, b"_NET_WM_CM_S%d" % screen, 0)
        self.cmd_atom = x.XInternAtom(self.dpy, b"_XCRT_COMMAND", 0)
        self.state_atom = x.XInternAtom(self.dpy, b"_XCRT_STATE", 0)
        self.owner = 0

    def _find_owner(self):
        w = self.x.XGetSelectionOwner(self.dpy, self.sel)
        if not w:
            return 0
        name = ctypes.c_char_p()
        ok = self.x.XFetchName(self.dpy, w, ctypes.byref(name))
        is_xcrt = bool(ok) and name.value == b"xcrt"
        if name.value is not None:
            self.x.XFree(name)
        return w if is_xcrt else 0

    def _read_property(self):
        c = ctypes
        atype, fmt = c.c_ulong(), c.c_int()
        n, after = c.c_ulong(), c.c_ulong()
        data = c.POINTER(c.c_ubyte)()
        status = self.x.XGetWindowProperty(
            self.dpy, self.owner, self.state_atom, 0, 65536, 0, self.XA_STRING,
            c.byref(atype), c.byref(fmt), c.byref(n), c.byref(after), c.byref(data))
        if status != 0 or not data:
            return None
        text = c.string_at(data, n.value).decode("utf-8", "replace")
        self.x.XFree(data)
        return text

    def read_state(self):
        """Returns the raw state text, or None when xcrt is not running."""
        if not self.owner:
            self.owner = self._find_owner()
            if not self.owner:
                return None
        text = self._read_property()
        if text is None:  # xcrt restarted or quit: look it up again next time
            self.owner = 0
        return text

    def send(self, lines):
        if not self.owner or not lines:
            return
        data = ("\n".join(lines) + "\n").encode()
        self.x.XChangeProperty(self.dpy, self.owner, self.cmd_atom, self.XA_STRING, 8,
                               self.PROP_MODE_APPEND, data, len(data))
        self.x.XFlush(self.dpy)


def parse_state(text):
    state, presets = {}, []
    for line in text.splitlines():
        key, sep, val = line.partition("=")
        if not sep:
            continue
        key, val = key.strip(), val.strip()
        if key == "available":
            presets.append(val)
        else:
            state[key] = val
    state["available"] = presets
    return state


def find_xcrt_binary():
    here = os.path.dirname(os.path.realpath(__file__))
    local = os.path.join(here, os.pardir, "xcrt")  # running from the source tree
    if os.access(local, os.X_OK):
        return os.path.realpath(local)
    return shutil.which("xcrt")


class Window(Gtk.Window):
    def __init__(self, link):
        super().__init__(title="xcrt")
        self.link = link
        self.state = {}
        self.raw_state = None
        self.updating = False      # True while widgets are being set from the state
        self.pending = {}          # key -> command line waiting to be sent
        self.last_edit = {}        # key -> time the user last touched it
        self.flush_id = 0
        self.controls = {}         # key -> (kind, widget)

        self.set_default_size(500, 600)
        self.set_border_width(0)
        self.connect("destroy", Gtk.main_quit)

        header = Gtk.HeaderBar(title="xcrt", show_close_button=True)
        self.set_titlebar(header)
        self.enabled = Gtk.Switch(valign=Gtk.Align.CENTER, tooltip_text="Turn the effect on or off")
        self.enabled.connect("notify::active", self.on_enabled)
        header.pack_start(self.enabled)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.add(root)

        # disconnected banner
        self.banner = Gtk.InfoBar(message_type=Gtk.MessageType.WARNING, show_close_button=False)
        self.banner_label = Gtk.Label(xalign=0, wrap=True)
        self.banner.get_content_area().add(self.banner_label)
        self.start_button = self.banner.add_button("Start xcrt", 1)
        self.banner.connect("response", self.on_start_xcrt)
        root.pack_start(self.banner, False, False, 0)

        self.body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, border_width=12)
        root.pack_start(self.body, True, True, 0)

        # preset row
        top = Gtk.Grid(column_spacing=8, row_spacing=8)
        self.body.pack_start(top, False, False, 0)
        top.attach(Gtk.Label(label="Preset", xalign=0), 0, 0, 1, 1)
        self.preset_combo = Gtk.ComboBoxText(hexpand=True)
        self.preset_combo.connect("changed", self.on_preset)
        top.attach(self.preset_combo, 1, 0, 1, 1)
        self.modified_label = Gtk.Label(xalign=0)
        self.modified_label.get_style_context().add_class("dim-label")
        top.attach(self.modified_label, 1, 1, 1, 1)

        buttons = Gtk.Box(spacing=6, halign=Gtk.Align.END)
        self.save_button = Gtk.Button(label="Save", tooltip_text="Write the current preset to the config file")
        self.save_button.get_style_context().add_class("suggested-action")
        self.save_button.connect("clicked", lambda b: self.send_now("save"))
        save_as = Gtk.Button(label="Save as…", tooltip_text="Save as a new preset")
        save_as.connect("clicked", self.on_save_as)
        self.reset_button = Gtk.Button(label="Discard", tooltip_text="Go back to this preset's saved values")
        self.reset_button.connect("clicked", lambda b: self.send_now("reset"))
        for b in (self.reset_button, save_as, self.save_button):
            buttons.pack_start(b, False, False, 0)
        top.attach(buttons, 0, 2, 2, 1)

        # global curvature intensity
        frame = Gtk.Frame(label=" Curvature intensity (all presets) ")
        adj = Gtk.Adjustment(value=100, lower=0, upper=300, step_increment=5, page_increment=10)
        self.curv_scale = Gtk.Scale(orientation=Gtk.Orientation.HORIZONTAL, adjustment=adj,
                                    digits=0, hexpand=True, margin=6)
        self.curv_scale.set_value_pos(Gtk.PositionType.RIGHT)
        self.curv_scale.connect("format-value", lambda s, v: "%d%%" % round(v))
        for mark in (0, 100, 200, 300):
            self.curv_scale.add_mark(mark, Gtk.PositionType.BOTTOM, None)
        adj.connect("value-changed", self.on_curvature_scale)
        frame.add(self.curv_scale)
        self.body.pack_start(frame, False, False, 0)

        # per-preset parameters
        notebook = Gtk.Notebook()
        self.body.pack_start(notebook, True, True, 0)
        for title, params in SECTIONS:
            grid = Gtk.Grid(column_spacing=12, row_spacing=6, border_width=12)
            for row, (key, label, lo, hi, step, digits) in enumerate(params):
                grid.attach(Gtk.Label(label=label, xalign=0), 0, row, 1, 1)
                grid.attach(self.make_control(key, lo, hi, step, digits), 1, row, 1, 1)
            scroller = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
            scroller.add(grid)
            notebook.append_page(scroller, Gtk.Label(label=title))

        self.status = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END)
        self.status.get_style_context().add_class("dim-label")
        self.body.pack_start(self.status, False, False, 0)

        self.show_all()
        self.poll()
        GLib.timeout_add(POLL_MS, self.poll)

    # ---- widgets -------------------------------------------------------

    def make_control(self, key, lo, hi, step, digits):
        if key == "mask":
            w = Gtk.ComboBoxText()
            for value, label in MASKS:
                w.append(value, label)
            w.connect("changed", lambda w: self.queue(key, "set mask %s" % w.get_active_id()))
            self.controls[key] = ("combo", w)
            return w
        if key == "monochrome":
            w = Gtk.Switch(halign=Gtk.Align.START)
            w.connect("notify::active",
                      lambda w, _: self.queue(key, "set monochrome %s" % ("true" if w.get_active() else "false")))
            self.controls[key] = ("switch", w)
            return w
        if key == "tint":
            w = Gtk.ColorButton(halign=Gtk.Align.START, use_alpha=False, title="Phosphor color")
            w.connect("color-set", self.on_tint)
            self.controls[key] = ("color", w)
            return w
        adj = Gtk.Adjustment(value=lo, lower=lo, upper=hi, step_increment=step, page_increment=step * 10)
        w = Gtk.Scale(orientation=Gtk.Orientation.HORIZONTAL, adjustment=adj, digits=digits, hexpand=True)
        w.set_value_pos(Gtk.PositionType.RIGHT)
        w.set_size_request(220, -1)
        adj.connect("value-changed",
                    lambda a: self.queue(key, "set %s %.*f" % (key, max(digits, 3), a.get_value())))
        self.controls[key] = ("scale", w)
        return w

    # ---- sending -------------------------------------------------------

    def queue(self, key, line):
        if self.updating:
            return
        self.pending[key] = line
        self.last_edit[key] = time.monotonic()
        if not self.flush_id:
            self.flush_id = GLib.timeout_add(SEND_MS, self.flush)

    def flush(self):
        self.flush_id = 0
        lines, self.pending = list(self.pending.values()), {}
        self.link.send(lines)
        return False

    def send_now(self, line):
        self.flush()
        self.link.send([line])

    def on_enabled(self, switch, _):
        self.queue("enabled", "on" if switch.get_active() else "off")

    def on_preset(self, combo):
        name = combo.get_active_text()
        if name:
            self.flush()  # finish edits on the old preset first
            self.queue("preset", "preset %s" % name)

    def on_curvature_scale(self, adj):
        self.queue("curvature_scale", "curvature %d%%" % round(adj.get_value()))

    def on_tint(self, button):
        c = button.get_rgba()
        self.queue("tint", "set tint %.4f %.4f %.4f" % (c.red, c.green, c.blue))

    def on_save_as(self, _):
        dialog = Gtk.Dialog(title="Save preset as", transient_for=self, modal=True)
        dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Save", Gtk.ResponseType.OK)
        dialog.set_default_response(Gtk.ResponseType.OK)
        box = dialog.get_content_area()
        box.set_spacing(6)
        box.set_border_width(12)
        box.add(Gtk.Label(label="Name of the new preset (letters, digits, - _ .):", xalign=0))
        entry = Gtk.Entry(activates_default=True, text=self.state.get("preset", "") + "-mine")
        box.add(entry)
        hint = Gtk.Label(xalign=0)
        box.add(hint)
        ok = dialog.get_widget_for_response(Gtk.ResponseType.OK)

        def validate(_=None):
            valid = bool(PRESET_NAME.match(entry.get_text()))
            ok.set_sensitive(valid)
            hint.set_markup("" if valid else "<small>Invalid name</small>")
        entry.connect("changed", validate)
        validate()
        dialog.show_all()
        if dialog.run() == Gtk.ResponseType.OK and PRESET_NAME.match(entry.get_text()):
            self.send_now("save %s" % entry.get_text())
        dialog.destroy()

    def on_start_xcrt(self, bar, response):
        binary = find_xcrt_binary()
        if not binary:
            self.banner_label.set_text("The xcrt executable was not found in PATH.")
            return
        log = open(os.devnull, "wb")
        subprocess.Popen([binary], stdout=log, stderr=log, start_new_session=True)
        self.banner_label.set_text("Starting xcrt…")

    # ---- receiving -----------------------------------------------------

    def poll(self):
        text = self.link.read_state()
        connected = text is not None
        self.banner.set_visible(not connected)
        self.body.set_sensitive(connected)
        self.enabled.set_sensitive(connected)
        if not connected:
            self.raw_state = None
            self.banner_label.set_markup(
                "<b>xcrt is not running</b> on display %s.\n"
                "It runs on XFCE or on window managers without their own compositor (i3, openbox, …)."
                % GLib.markup_escape_text(self.link.display_name))
            return True
        if text != self.raw_state:
            self.raw_state = text
            self.apply_state(parse_state(text))
        return True

    def recently_edited(self, key):
        return time.monotonic() - self.last_edit.get(key, 0) < ECHO_GRACE_S or key in self.pending

    def apply_state(self, st):
        self.state = st
        self.updating = True
        try:
            if not self.recently_edited("enabled"):
                self.enabled.set_active(st.get("enabled") == "1")

            names = st["available"]
            model_names = [row[0] for row in self.preset_combo.get_model()]
            if names != model_names:
                self.preset_combo.remove_all()
                for n in names:
                    self.preset_combo.append_text(n)
            if not self.recently_edited("preset") and st.get("preset") in names:
                self.preset_combo.set_active(names.index(st["preset"]))

            modified = st.get("modified") == "1"
            # a blank line keeps the layout from jumping when the hint appears
            self.modified_label.set_markup("<small>%s</small>" % ("• unsaved changes" if modified else " "))
            self.reset_button.set_sensitive(modified)

            if not self.recently_edited("curvature_scale"):
                self.curv_scale.set_value(float(st.get("curvature_scale", 1)) * 100)

            for key, (kind, w) in self.controls.items():
                if key not in st or self.recently_edited(key):
                    continue
                val = st[key]
                if kind == "scale":
                    w.set_value(float(val))
                elif kind == "combo":
                    w.set_active_id(val)
                elif kind == "switch":
                    w.set_active(val == "true")
                elif kind == "color":
                    r, g, b = (min(max(float(v), 0.0), 1.0) for v in val.split()[:3])
                    w.set_rgba(Gdk.RGBA(r, g, b, 1.0))

            config = st.get("config", "")
            home = os.path.expanduser("~")
            if config.startswith(home + "/"):
                config = "~" + config[len(home):]
            self.status.set_text("Connected to xcrt on %s  ·  %s" % (self.link.display_name, config))
        finally:
            self.updating = False


def main():
    try:
        link = XcrtLink()
    except RuntimeError as e:
        print("xcrt-gui: %s" % e, file=sys.stderr)
        return 1
    Window(link)
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
