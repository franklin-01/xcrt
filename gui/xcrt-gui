    ("Geometry", [
        ("curvature_x", "Horizontal curvature", 0.0, 0.30, 0.005, 3),
        ("curvature_y", "Vertical curvature", 0.0, 0.30, 0.005, 3),
        ("corner_radius", "Rounded corners", 0.0, 0.15, 0.005, 3),
    ]),
    ("Lines & mask", [
        ("scanline_strength", "Scanline strength", 0.0, 1.0, 0.01, 2),
        ("scanline_size", "Scanline height (px)", 1.0, 8.0, 0.5, 1),
        ("mask", "Phosphor mask", None, None, None, None),
        ("mask_strength", "Mask strength", 0.0, 1.0, 0.01, 2),
        ("mask_size", "Triad size (px)", 1.0, 8.0, 0.5, 1),
    ]),
    ("Image", [
        ("softness", "Beam softness (px)", 0.0, 3.0, 0.05, 2),
        ("chroma", "Chromatic aberration (px)", 0.0, 4.0, 0.05, 2),
        ("bloom", "Bloom", 0.0, 1.0, 0.01, 2),
        ("bloom_radius", "Bloom radius", 0.2, 4.0, 0.05, 2),
        ("vignette", "Vignette", 0.0, 1.0, 0.01, 2),
        ("brightness", "Brightness", 0.5, 2.5, 0.01, 2),
        ("contrast", "Contrast", 0.5, 2.0, 0.01, 2),
        ("saturation", "Saturation", 0.0, 2.0, 0.01, 2),
        ("gamma", "Gamma", 0.5, 2.0, 0.01, 2),
    ]),
    ("Phosphor", [
