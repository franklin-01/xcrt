"""xcrt-gui: graphical control panel for a running xcrt.

Reads the state xcrt publishes in the _XCRT_STATE property and sends commands
through the _XCRT_COMMAND property (the same channel as `xcrt -s`), directly
through Xlib.
"""

import ctypes
import ctypes.util
import os
import re
import shutil
import subprocess
import sys
import time

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, GLib, Gtk, Pango  # noqa: E402

POLL_MS = 150       # how often the published state is re-read
SEND_MS = 30        # slider updates are coalesced into one send per interval
ECHO_GRACE_S = 0.6  # ignore state echoes for a control the user just moved

# (key, label, min, max, step, digits)
